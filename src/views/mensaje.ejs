<!DOCTYPE html>
<html lang="es">
<head>
    <title>
        <%= titulo %>
    </title>
    <link rel="stylesheet" href="/css/mensaje.css">
</head>
<body>
    <div class="glass-card-container">
        <div class="glass-card">
            <h1>
                <%= titulo %>
            </h1>

            <p>
                <%= mensaje %>
            </p>

            <% if (redireccionar) { %>
                <a href="<%= link %>"><%= linkMensaje %></a>
            <% } %>
        </div>
    </div>
</body>
</html>