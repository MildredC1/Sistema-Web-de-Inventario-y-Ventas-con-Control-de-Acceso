<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <!-- importar iconos para el formulario -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/public/css/login.css">
</head>
<body>
    <div class="background">
        </div>
    <div class="login-container">
        <form class="login-form" method="post" action="/login">
            <div class="avatar-placeholder">
                <i class="fa-solid fa-user-large"></i> 
                </div>

            <div class="input-group">
                <i class="fas fa-envelope icon"></i>
                <input type="email" id="email" name="correo" placeholder="Correo" required>

                </div>

            <div class="input-group">
                <i class="fas fa-lock icon"></i>
                <input type="password" id="password" name="contrasena" placeholder="Contraseña" required>
            </div>

            <div class="actions">
                <button type="submit" class="btn login-btn">Login</button>
                <a href="#" class="forgot-password">Olvidaste tu contraseña?</a>
            </div>
        </form>
        <a href="/registro" class="btn register-btn">Crear nueva cuenta</a>
        

    </div>
</body>
</html>